# Choose which provider to use: "gemini" or "openai"
LLM_PROVIDER = gemini

# Absolute path to the repo you want AI Crash Fix to analyze.
# Default: current working directory
REPO_ROOT = /absolute/path/to/your/target/repo

# The main branch of the Fix Generation PR.
MAIN_BRANCH = main

# --- OpenAI ---
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY = your_openai_api_key_here
# Optional
OPENAI_MODEL = gpt-4o-mini
OPENAI_URL = https://api.openai.com/v1

# --- Gemini ---
# Required if LLM_PROVIDER=gemini
# Either key name works with the new SDK; prefer GEMINI_API_KEY.
GOOGLE_API_KEY = your_google_api_key_here
# Optional
GEMINI_MODEL = gemini-2.5-flash


# --- BigQuery / Crashlytics fetch ---
GOOGLE_APPLICATION_CREDENTIALS = path/to/service-account.json
BQ_PROJECT_ID = your-project-id
# Where to read crashes: "bigquery" (default) or "cloud_logging" (Crashlytics log router).
CRASHLYTICS_FETCH_BACKEND = bigquery
BQ_DATASET = firebase_crashlytics
BQ_CRASHLYTICS_ANDROID_TABLE = package_name_ANDROID
BQ_CRASHLYTICS_IOS_TABLE = package_name_IOS


# --- Jira ---
JIRA_SERVER_URL = "https://your-domain.atlassian.net"
JIRA_EMAIL = "your-email"
JIRA_TOKEN = "your-api-token"
JIRA_VERIFY_SSL = true

JIRA_PROJECT_KEY = "CRASH"
JIRA_ISSUE_TYPE = "Bug"

# --- GitLab ---
GITLAB_SERVER_URL = "https://your-domain.gitlab.com"
GITLAB_PROJECT = "your-project"
GITLAB_TOKEN = "your-api-token"
GITLAB_VERIFY_SSL = true


# --- Logging ---
# Preferred logging vars; CRASHLENS_GRAPH_LOG_LEVEL / CRASHLENS_GRAPH_LOG_STYLE are still read if these are unset.
AI_CRASH_FIX_GRAPH_LOG_LEVEL = INFO
AI_CRASH_FIX_GRAPH_LOG_STYLE = pretty