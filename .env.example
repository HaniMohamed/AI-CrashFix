# Choose which provider to use: "gemini", "openai", or "gosi-brain"
LLM_PROVIDER = gemini

# Absolute path to the repo you want AI Crash Fix to analyze.
# Default: current working directory
# Legacy fallback if you don't provide `repo_url` per run:
# REPO_ROOT = /absolute/path/to/your/target/repo

# Where the backend clones user-provided remote repositories:
WORKSPACE_PROJECTS_DIR = workspace_projects

# Optional: monorepo packages directory (Melos, etc).
# This directory is expected to contain child package directories, each with its own `lib/`:
#   <LOCAL_PACKAGES_DIR>/<packageName>/lib/...
# Example:
# LOCAL_PACKAGES_DIR=packages

# The main branch of the Fix Generation PR.
MAIN_BRANCH = main

# --- OpenAI ---
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY = your_openai_api_key_here
# Optional
OPENAI_MODEL = gpt-4o-mini
OPENAI_URL = https://api.openai.com/v1

# --- Gemini ---
# Required if LLM_PROVIDER=gemini
# Either key name works with the new SDK; prefer GEMINI_API_KEY.
GOOGLE_API_KEY = your_google_api_key_here
# Optional
GEMINI_MODEL = gemini-2.5-flash

# --- GOSI Brain ---
# Required if LLM_PROVIDER=gosi-brain (OpenAI-style chat/completions with custom headers).
# Quote Authorization (space after Bearer) and Cookie if this file is sourced by bash.
# Cookie: copy the Cookie header from a working Postman/curl request (F5 TS* rotates).
# GOSI_BRAIN_URL=https://intsol.gosi.gov.sa/v1/iwaiapiproxy/chat/completions
# GOSI_BRAIN_MODEL=gosi_brain_agent
# GOSI_BRAIN_AUTHORIZATION="Bearer eyJ..."
# GOSI_BRAIN_API_KEY=your_x_apikey
# GOSI_BRAIN_USER_ID=CR240821
# GOSI_BRAIN_COOKIE="TS016ee342=..."
# GOSI_BRAIN_STREAMING=off
# Optional:
# GOSI_BRAIN_OAUTH_IDENTITY_DOMAIN_NAME=MobileDomain
# GOSI_BRAIN_SEND_OAUTH_DOMAIN=false
# GOSI_BRAIN_TEMPERATURE=0.7
# GOSI_BRAIN_MAX_REQUEST_BYTES=48000
# GOSI_BRAIN_PROMPT_COMPACTION=auto
# GOSI_BRAIN_TIMEOUT=300
# GOSI_BRAIN_CONNECT_TIMEOUT=30
# GOSI_BRAIN_IDLE_TIMEOUT=120
# GOSI_BRAIN_WAF_CONTENT_SHIELD=true
# GOSI_BRAIN_GZIP_REQUEST=false


# --- BigQuery / Crashlytics fetch ---
GOOGLE_APPLICATION_CREDENTIALS = path/to/service-account.json
BQ_PROJECT_ID = your-project-id
# Optional: Firebase Console project (defaults to BQ_PROJECT_ID).
# FIREBASE_CONSOLE_PROJECT_ID = your-firebase-console-project
# Optional: default app id segment for Crashlytics deep links when the export row has no bundle/package.
# CRASHLYTICS_ANDROID_PACKAGE = com.example.app
# CRASHLYTICS_IOS_BUNDLE_ID = com.example.app
# Where to read crashes: "bigquery" (default) or "cloud_logging" (Crashlytics log router).
CRASHLYTICS_FETCH_BACKEND = bigquery
BQ_DATASET = firebase_crashlytics
BQ_CRASHLYTICS_ANDROID_TABLE = package_name_ANDROID
BQ_CRASHLYTICS_IOS_TABLE = package_name_IOS


# --- Jira ---
JIRA_SERVER_URL = "https://your-domain.atlassian.net"
JIRA_EMAIL = "your-email"
JIRA_TOKEN = "your-api-token"
JIRA_VERIFY_SSL = true
# auto (default): Cloud → Basic email+token; Server/DC → Bearer PAT
# basic | bearer to force a scheme (use bearer for on-prem personal access tokens)
JIRA_AUTH = auto
# Required custom fields for create (JSON). DE Bug screens require Concerned DE Team:
# JIRA_CREATE_FIELDS={"customfield_11404":{"value":"Individual App + Taqdeer"}}

JIRA_PROJECT_KEY = "CRASH"
JIRA_ISSUE_TYPE = "Bug"

# --- GitLab ---
GITLAB_SERVER_URL = "https://your-domain.gitlab.com"
GITLAB_PROJECT = "your-project"
GITLAB_TOKEN = "your-api-token"
GITLAB_VERIFY_SSL = true


# --- Logging ---
# Preferred logging vars; CRASHLENS_GRAPH_LOG_LEVEL / CRASHLENS_GRAPH_LOG_STYLE are still read if these are unset.
AI_CRASH_FIX_GRAPH_LOG_LEVEL = INFO
AI_CRASH_FIX_GRAPH_LOG_STYLE = pretty

# --- Shared store (crash pipeline + repos/settings when postgres) ---
# Default: local SQLite files under db/ (unchanged). Use postgres for a shared team store.
# AI_CRASH_FIX_CRASH_STORE_BACKEND = sqlite
# AI_CRASH_FIX_CRASH_STORE_BACKEND = postgres
# AI_CRASH_FIX_CRASH_DB_URL = postgresql://ai_crash_fix:password@localhost:5432/ai_crash_fix
# Machine identity for per-user repos/settings AND GOSI Brain custom_session (case-insensitive store).
# Required when backend=postgres. When set, GOSI_BRAIN_USER_ID is ignored for identity.
# AI_CRASH_FIX_USER_ID = cr231120
# Repo-data read-only flag lives in app_settings (REPO_DATA_READONLY), not env.
# scripts/set_repo_data_readonly.py true|false