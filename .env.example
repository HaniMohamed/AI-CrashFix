# Fixora configuration (bootstrap + optional seeds)

Day-to-day secrets and integrations should be set in the Fixora UI
(Setup Wizard / Settings). They persist in SQLite or Postgres app_settings.

Use this file only for:
- first-time bootstrap (store backend, data dir, machine user id)
- optional one-shot seed via AI_CRASH_FIX_ENV_FILE (host app / advanced)
- local development convenience

Copy to `.env` if needed. Keys already saved in Settings override these at runtime.

# --- Bootstrap (ops / team mode) ---
# AI_CRASH_FIX_CRASH_STORE_BACKEND = sqlite
# AI_CRASH_FIX_CRASH_STORE_BACKEND = postgres
# AI_CRASH_FIX_CRASH_DB_URL = postgresql://ai_crash_fix:password@localhost:5432/ai_crash_fix
# Required when backend=postgres:
# AI_CRASH_FIX_USER_ID = your.machine.id
# AI_CRASH_FIX_DATA_DIR =
# AI_CRASH_FIX_ENV_FILE =

WORKSPACE_PROJECTS_DIR = workspace_projects
MAIN_BRANCH = main
# Optional monorepo packages dir (Melos, etc):
# LOCAL_PACKAGES_DIR = packages

# --- LLM (optional if configured in UI) ---
LLM_PROVIDER = gemini
# OPENAI_API_KEY =
# OPENAI_MODEL = gpt-4o-mini
# OPENAI_URL = https://api.openai.com/v1
# GOOGLE_API_KEY =
# GEMINI_MODEL = gemini-2.5-flash

# Advanced OpenAI-compatible gateway (optional):
# LLM_PROVIDER = gosi-brain
# GOSI_BRAIN_URL =
# GOSI_BRAIN_MODEL =
# GOSI_BRAIN_AUTHORIZATION = "Bearer …"
# GOSI_BRAIN_API_KEY =
# GOSI_BRAIN_STREAMING = auto

# --- Crashlytics / GCP (optional if configured in UI) ---
# GOOGLE_APPLICATION_CREDENTIALS = path/to/service-account.json
# BQ_PROJECT_ID =
# FIREBASE_CONSOLE_PROJECT_ID =
# CRASHLYTICS_FETCH_BACKEND = bigquery
# BQ_DATASET = firebase_crashlytics
# BQ_CRASHLYTICS_ANDROID_TABLE =
# BQ_CRASHLYTICS_IOS_TABLE =
# CRASHLYTICS_ANDROID_PACKAGE =
# CRASHLYTICS_IOS_BUNDLE_ID =

# --- Jira (optional if configured in UI) ---
# JIRA_SERVER_URL =
# JIRA_EMAIL =
# JIRA_TOKEN =
# JIRA_VERIFY_SSL = true
# JIRA_AUTH = auto
# JIRA_PROJECT_KEY =
# JIRA_ISSUE_TYPE = Bug
# JIRA_CREATE_FIELDS =

# --- GitLab (optional if configured in UI) ---
# GITLAB_SERVER_URL =
# GITLAB_PROJECT =
# GITLAB_TOKEN =
# GITLAB_VERIFY_SSL = true

# --- Logging ---
AI_CRASH_FIX_GRAPH_LOG_LEVEL = INFO
AI_CRASH_FIX_GRAPH_LOG_STYLE = pretty
